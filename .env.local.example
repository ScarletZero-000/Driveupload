# Salin file ini jadi .env.local lalu isi dengan nilai asli

# Email dari Service Account Google Cloud
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key dari Service Account (salin seluruhnya termasuk -----BEGIN...-----END-----)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"

# (Opsional) ID folder Google Drive tujuan upload
# Kosongkan jika mau upload ke root My Drive
GOOGLE_DRIVE_FOLDER_ID=
